{
  "name": "translate-ext",
  "version": "1.2.1",
  "description": "AI immersive translation browser extension",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:safari": "wxt -b safari",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:safari": "wxt zip -b safari",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "npx tsx scripts/smoke.test.ts",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.37.0",
    "mammoth": "^1.12.2",
    "onnxruntime-web": "^1.29.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  },
  "private": true,
  "type": "module"
}
